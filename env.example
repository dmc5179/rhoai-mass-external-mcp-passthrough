# Copy to <server>.env (git-ignored), fill in, then: scripts/render.sh <server>.env
# One env file per external MCP server.

# --- Gateway (same for every server) ---
MCP_GATEWAY_NAME=mcp-gateway
MCP_GATEWAY_NAMESPACE=mcp-gateway
MCP_GATEWAY_PUBLIC_LISTENER=mcp       # listener clients connect to
MCP_GATEWAY_INTERNAL_LISTENER=mcps    # *.mcp.local listener for backends
MCP_PUBLIC_HOSTNAME=mcp.apps.example.com
OIDC_ISSUER_URL=https://idp.example.com/realms/mcp

# --- This external MCP server ---
MCP_SERVER_NAME=example-mcp           # DNS-safe; used for object names and <name>.mcp.local
MCP_SERVER_NAMESPACE=mcp-servers
MCP_TOOL_PREFIX=example_              # letters/digits/_ only
EXTERNAL_MCP_HOST=mcp.example.com
EXTERNAL_MCP_PORT=443
EXTERNAL_MCP_PATH=/mcp

# Discovery-only credential, sent verbatim as the Authorization header.
BROKER_CREDENTIAL="Bearer replace-with-long-lived-service-credential"
